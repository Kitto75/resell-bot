+import asyncio
+import os
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+os.environ.setdefault("BOT_TOKEN", "123:test")
+os.environ.setdefault("ADMIN_IDS", "1")
+os.environ.setdefault("MARZBAN_BASE_URL", "https://panel.example")
+os.environ.setdefault("MARZBAN_USERNAME", "admin")
+os.environ.setdefault("MARZBAN_PASSWORD", "password")
+
+from aiogram.fsm.context import FSMContext
+from aiogram.fsm.storage.base import StorageKey
+from aiogram.fsm.storage.memory import MemoryStorage
+from aiogram.types import BufferedInputFile
+
+from app.database.models import ResellerStatus
+from app.handlers import admin, admin_search, reseller
+from app.services import delivery
+from app.services.delivery import BYTES_PER_GB, account_line, accounts_list_text, build_caption, limit_text, send_account_message
+from app.services.marzban import MarzbanError, ownership_note
+from app.states.reseller import MyUsers
+
+URL = "https://panel.example/sub/abc123?x=1&y=2"
+
+
+def _msg():
+    return SimpleNamespace(answer=AsyncMock(), answer_photo=AsyncMock(), from_user=SimpleNamespace(id=5))
+
+
+def _state():
+    return FSMContext(storage=MemoryStorage(), key=StorageKey(bot_id=1, chat_id=1, user_id=1))
+
+
+# ----------------------------------------------------------------- formats
+def test_name_limit_formats_match_the_requested_style():
+    assert account_line("testaccount", 35 * BYTES_PER_GB) == "testaccount | 35GB"
+    assert account_line("testaccount", 35 * BYTES_PER_GB, 31) == "testaccount | 35 GB | 31 Days"
+    assert account_line("a", 10 * BYTES_PER_GB, 1) == "a | 10 GB | 1 Day"
+    assert limit_text(int(10.5 * BYTES_PER_GB)) == "10.5GB" and limit_text(0) == "Unlimited" and limit_text(None) == "Unlimited"
+
+
+def test_caption_has_line_then_link_in_monospace_and_escapes_html():
