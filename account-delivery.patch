+# ----------------------------------------------------------------- reseller lookup
+class FakeClient:
+    def __init__(self, users): self.users = users
+    def absolute_subscription_url(self, value): return value
+    async def get_user(self, username):
+        if username not in self.users: raise MarzbanError("nf", 404)
+        return self.users[username]
+
+
+def _reseller(status=ResellerStatus.active):
+    return SimpleNamespace(id=1, display_name="plex", status=status)
+
+
+def _lookup(monkeypatch, text, users, reseller_obj=None):
+    monkeypatch.setattr(reseller, "client", lambda: FakeClient(users))
+    msg = _msg(); msg.text = text
+    asyncio.run(reseller.my_user_link_lookup(msg, _state(), reseller_obj or _reseller()))
+    return msg
+
+
+OWN = {"username": "mine", "data_limit": 35 * BYTES_PER_GB, "subscription_url": URL, "note": ownership_note("plex")}
+OTHER = {"username": "theirs", "data_limit": 5 * BYTES_PER_GB, "subscription_url": URL, "note": ownership_note("someone_else")}
+
+
+def test_reseller_gets_link_and_qr_for_own_account_only(monkeypatch):
+    own = _lookup(monkeypatch, "  Mine ", {"mine": OWN, "theirs": OTHER})
+    assert own.answer_photo.await_args.kwargs["caption"].startswith("mine | 35GB\n\n<code>https://panel.example/sub/abc123") and own.answer.await_count == 0
+
+    denied = _lookup(monkeypatch, "theirs", {"mine": OWN, "theirs": OTHER})
+    missing = _lookup(monkeypatch, "nobody", {"mine": OWN})
+    invalid = _lookup(monkeypatch, "not a name!", {"mine": OWN})
+    for m in (denied, missing, invalid): m.answer_photo.assert_not_awaited()
+    assert denied.answer.await_args.args[0] == missing.answer.await_args.args[0] == reseller.ACCOUNT_NOT_FOUND  # same text: no hint that the name exists
+    assert "نامعتبر" in invalid.answer.await_args.args[0]
+
